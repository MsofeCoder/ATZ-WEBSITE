# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
tsconfig.tsbuildinfo

# env files. `.env*` would also swallow .env.example, which is the only
# record of which variables the app needs — the README tells you to copy
# it, and it was never in the repo to copy.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright artefacts
test-results/
playwright-report/

# Local scratch/verification output — never part of the app
.ogcheck/
shots/
dev-server.log
