# Copy to .env.local and fill in. Every variable the app reads is listed here;
# `src/lib/env.ts` is the only place they are parsed.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap, robots, JSON-LD and Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://atzcompany.co.tz

# ---------------------------------------------------------------------------
# Lead delivery — AT LEAST ONE IS REQUIRED IN PRODUCTION (NEXT_PUBLIC_WEB3FORMS_KEY counts)
#
# With neither configured, POST /api/lead returns 503 and refuses the
# submission rather than accepting an enquiry nobody will ever read. (In
# development it logs the lead and returns ok, so the form is testable.)
# ---------------------------------------------------------------------------

# Backend 1: Web3Forms (free tier: 250 submissions/month; notifications land
# in the inbox the key was issued for).
#   1. https://web3forms.com -> "Create your Access Key"
#   2. Enter the inbox that should receive leads (e.g. msofedesigner@gmail.com)
#   3. Paste the key sent to that inbox below.
# The free tier only accepts submissions FROM THE BROWSER (server calls get a
# 403), so this is a NEXT_PUBLIC_ variable: the form posts to /api/lead for
# validation and bot filtering first, then to Web3Forms from the page.
# Web3Forms designs access keys to be public.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Pro plan with the server IP allow-listed only: server-side Web3Forms post.
WEB3FORMS_ACCESS_KEY=

# Backend 2: generic webhook (Formspree / Zapier / Make / your own endpoint).
# Receives the lead as a JSON POST.
LEAD_WEBHOOK_URL=

# Backend 3: email notification via Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@atzcompany.co.tz
# Must be a verified sender on your Resend account. The default only works for
# testing — - Resend rejects it for real delivery.
LEAD_FROM_EMAIL=ATZ Website <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Upstash Redis — optional, strongly recommended in production
#
# Two things degrade without it, silently:
#
#   1. Durable lead storage. Leads are written to Redis *before* any delivery
#      is attempted, so a webhook or email outage degrades to "we have it,
#      nobody was paged" instead of losing the enquiry. Without Redis a failed
#      delivery means the lead is gone.
#   2. Rate limiting. The limiter falls back to an in-memory window, which is
#      per-instance — so on serverless the effective limit is multiplied by
#      however many instances happen to be warm.
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
